@{
    ViewData["Title"] = "Prefinal Exam";
}

<div class="exam-home">

    <div class="hero-section">
        <div class="hero-content">
            <span class="exam-badge">IT ELECTIVE 2</span>

            <h1>Prefinal Examination</h1>

            <p class="hero-subtitle">
                Web System and Technologies
            </p>

            <p class="student-info">
                Danielle Allyne O. Marcos
                <br />
                BSIT 31E3
            </p>

            <a asp-controller="Home"
               asp-action="Questions"
               class="start-button">
                Start Answering
            </a>
        </div>
    </div>

    <div class="content-section" id="exam-info">

        <div class="section-heading">
            <span>YOUR EXAM GUIDE</span>

            <h2>Prepare. Review. Answer.</h2>

            <p>
                Review the 20 questions included in your IT Elective 2
                Prefinal Examination.
            </p>
        </div>

        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-number">20</div>
                <div class="stat-title">Questions</div>
                <div class="stat-text">
                    Total examination items
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-number">4</div>
                <div class="stat-title">Topics</div>
                <div class="stat-text">
                    Major areas to review
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-number">A-D</div>
                <div class="stat-title">Choices</div>
                <div class="stat-text">
                    Multiple choice format
                </div>
            </div>

        </div>

        <div class="topics-section">

            <h2>Exam Topics</h2>

            <div class="topic-grid">

                <div class="topic-card">
                    <span class="topic-number">01</span>

                    <h3>EF Core</h3>

                    <p>
                        Relational data modeling and Entity Framework Core.
                    </p>
                </div>

                <div class="topic-card">
                    <span class="topic-number">02</span>

                    <h3>ERD & Razor</h3>

                    <p>
                        Relationships, ERD concepts and dynamic rendering.
                    </p>
                </div>

                <div class="topic-card">
                    <span class="topic-number">03</span>

                    <h3>Validation</h3>

                    <p>
                        Normalization, validation and data integrity.
                    </p>
                </div>

                <div class="topic-card">
                    <span class="topic-number">04</span>

                    <h3>CRUD & SQL</h3>

                    <p>
                        SQL operations, in-memory data and CRUD concepts.
                    </p>
                </div>

            </div>

        </div>

        <div class="review-card">

            <div>
                <span class="review-label">PREFINAL EXAM</span>

                <h2>Ready to review?</h2>

                <p>
                    Go through each question and check the correct answer
                    and explanation.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Questions"
               class="review-button">
                View Questions
            </a>

        </div>

    </div>

</div>

<style>

    * {
        box-sizing: border-box;
    }

    .exam-home {
        margin: -24px;
        min-height: 100vh;
        background: #f5f7fb;
        color: #172033;
    }

    .hero-section {
        min-height: 520px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 70px 20px;
        background: radial-gradient(circle at top left, #5b7cfa 0, transparent 35%), radial-gradient(circle at bottom right, #9b5de5 0, transparent 35%), linear-gradient(135deg, #111827, #273469);
        color: white;
    }

    .hero-content {
        max-width: 800px;
    }

    .exam-badge {
        display: inline-block;
        padding: 8px 18px;
        border: 1px solid rgba(255,255,255,.4);
        border-radius: 30px;
        font-size: 13px;
        letter-spacing: 2px;
        margin-bottom: 20px;
    }

    .hero-section h1 {
        font-size: 58px;
        font-weight: 800;
        margin: 0;
    }

    .hero-subtitle {
        font-size: 22px;
        margin: 15px 0;
        color: #dbe4ff;
    }

    .student-info {
        font-size: 16px;
        line-height: 1.8;
        color: #e5e7eb;
    }

    .start-button,
    .review-button {
        display: inline-block;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        transition: .2s;
    }

    .start-button {
        margin-top: 20px;
        background: white;
        color: #172033;
    }

        .start-button:hover,
        .review-button:hover {
            transform: translateY(-3px);
        }

    .content-section {
        max-width: 1100px;
        margin: auto;
        padding: 70px 25px;
    }

    .section-heading {
        text-align: center;
        margin-bottom: 40px;
    }

        .section-heading span,
        .review-label {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 2px;
            color: #6675e8;
        }

        .section-heading h2 {
            font-size: 36px;
            margin: 8px 0;
        }

        .section-heading p {
            color: #687386;
        }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 70px;
    }

    .stat-card {
        background: white;
        padding: 30px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(20,30,60,.07);
    }

    .stat-number {
        font-size: 40px;
        font-weight: 800;
        color: #6675e8;
    }

    .stat-title {
        font-size: 18px;
        font-weight: 700;
        margin-top: 5px;
    }

    .stat-text {
        color: #7b8494;
        margin-top: 5px;
    }

    .topics-section {
        margin-bottom: 60px;
    }

        .topics-section > h2 {
            text-align: center;
            margin-bottom: 30px;
            font-size: 30px;
        }

    .topic-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .topic-card {
        position: relative;
        background: white;
        padding: 30px;
        border-radius: 20px;
        border: 1px solid #e8ebf2;
        transition: .2s;
    }

        .topic-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(20,30,60,.1);
        }

    .topic-number {
        font-size: 13px;
        font-weight: 800;
        color: #6675e8;
    }

    .topic-card h3 {
        font-size: 23px;
        margin: 12px 0 8px;
    }

    .topic-card p {
        color: #6b7280;
        line-height: 1.6;
    }

    .review-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 35px;
        border-radius: 24px;
        background: #111827;
        color: white;
    }

        .review-card h2 {
            margin: 8px 0;
            font-size: 30px;
        }

        .review-card p {
            color: #cbd5e1;
            margin: 0;
        }

    .review-button {
        background: white;
        color: #111827;
        white-space: nowrap;
    }

    @@media (max-width: 700px) {

        .hero-section h1 {
            font-size: 40px;
        }

        .stats-grid,
        .topic-grid {
            grid-template-columns: 1fr;
        }

        .review-card {
            flex-direction: column;
            align-items: flex-start;
        }
    }

</style>


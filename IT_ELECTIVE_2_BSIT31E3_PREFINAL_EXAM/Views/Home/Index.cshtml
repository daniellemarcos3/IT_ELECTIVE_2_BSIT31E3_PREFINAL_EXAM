@{
    ViewData["Title"] = "Prefinal Exam";
}

<div class="exam-home">

    <div class="background-shape shape-one"></div>
    <div class="background-shape shape-two"></div>
    <div class="background-shape shape-three"></div>

    <section class="hero-section">

        <div class="hero-content">

            <div class="top-label">
                <span class="label-dot"></span>
                IT ELECTIVE 2
            </div>

            <div class="hero-icon">
                &lt;/&gt;
            </div>

            <p class="mini-title">
                WEB SYSTEM AND TECHNOLOGIES
            </p>

            <h1>
                Prefinal
                <span>Examination</span>
            </h1>

            <p class="hero-description">
                Test your knowledge in web development,
                database concepts, validation, and ASP.NET Core MVC.
            </p>

            <div class="student-card">

                <div class="student-avatar">
                    DM
                </div>

                <div class="student-details">
                    <span>EXAMINEE</span>
                    <strong>Danielle Allyne O. Marcos</strong>
                    <small>BSIT 31E3</small>
                </div>

            </div>

            <div class="hero-buttons">

                <a asp-controller="Home"
                   asp-action="Questions"
                   class="start-button">
                    <span>Start Answering</span>
                    <b>→</b>
                </a>

                <a href="#exam-info"
                   class="info-button">
                    View Exam Guide
                </a>

            </div>

        </div>

        <div class="hero-decoration">

            <div class="floating-card card-one">
                <span>20</span>
                <small>QUESTIONS</small>
            </div>

            <div class="floating-card card-two">
                <span>4</span>
                <small>TOPICS</small>
            </div>

            <div class="code-window">

                <div class="window-top">
                    <div class="window-dots">
                        <i></i>
                        <i></i>
                        <i></i>
                    </div>

                    <span>Exam.cshtml</span>
                </div>

                <div class="code-content">
                    <p><span class="code-purple">const</span> exam = {</p>
                    <p class="indent">
                        questions: <span class="code-blue">20</span>,
                    </p>
                    <p class="indent">
                        choices: <span class="code-string">"A-D"</span>,
                    </p>
                    <p class="indent">
                        topic: <span class="code-string">"Web Systems"</span>
                    </p>
                    <p>};</p>
                </div>

            </div>

        </div>

    </section>


    <section class="content-section" id="exam-info">

        <div class="section-heading">

            <div class="section-tag">
                YOUR EXAM GUIDE
            </div>

            <h2>
                Prepare. Review. <span>Answer.</span>
            </h2>

            <p>
                Review the 20 questions included in your
                IT Elective 2 Prefinal Examination.
            </p>

        </div>


        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon">
                    ?
                </div>

                <div>
                    <div class="stat-number">20</div>
                    <div class="stat-title">Questions</div>
                    <div class="stat-text">
                        Total examination items
                    </div>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    #
                </div>

                <div>
                    <div class="stat-number">4</div>
                    <div class="stat-title">Topics</div>
                    <div class="stat-text">
                        Major areas to review
                    </div>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    A
                </div>

                <div>
                    <div class="stat-number">A-D</div>
                    <div class="stat-title">Choices</div>
                    <div class="stat-text">
                        Multiple choice format
                    </div>
                </div>

            </div>

        </div>


        <div class="topics-section">

            <div class="topic-heading">

                <div>
                    <span>WHAT YOU WILL REVIEW</span>
                    <h2>Exam Topics</h2>
                </div>

                <div class="topic-count">
                    04 TOPICS
                </div>

            </div>


            <div class="topic-grid">

                <div class="topic-card">

                    <div class="topic-top">
                        <span class="topic-number">01</span>
                        <span class="topic-symbol">&lt;/&gt;</span>
                    </div>

                    <h3>EF Core</h3>

                    <p>
                        Relational data modeling and Entity Framework Core.
                    </p>

                    <div class="topic-line"></div>

                </div>


                <div class="topic-card">

                    <div class="topic-top">
                        <span class="topic-number">02</span>
                        <span class="topic-symbol">◇</span>
                    </div>

                    <h3>ERD & Razor</h3>

                    <p>
                        Relationships, ERD concepts and dynamic rendering.
                    </p>

                    <div class="topic-line"></div>

                </div>


                <div class="topic-card">

                    <div class="topic-top">
                        <span class="topic-number">03</span>
                        <span class="topic-symbol">✓</span>
                    </div>

                    <h3>Validation</h3>

                    <p>
                        Normalization, validation and data integrity.
                    </p>

                    <div class="topic-line"></div>

                </div>


                <div class="topic-card">

                    <div class="topic-top">
                        <span class="topic-number">04</span>
                        <span class="topic-symbol">DB</span>
                    </div>

                    <h3>CRUD & SQL</h3>

                    <p>
                        SQL operations, in-memory data and CRUD concepts.
                    </p>

                    <div class="topic-line"></div>

                </div>

            </div>

        </div>


        <div class="review-card">

            <div class="review-decoration">
                <span>&lt;</span>
                <span>/</span>
                <span>&gt;</span>
            </div>

            <div class="review-content">

                <span class="review-label">
                    PREFINAL EXAMINATION
                </span>

                <h2>
                    Ready to test your knowledge?
                </h2>

                <p>
                    Go through each question and check the correct answer
                    and explanation.
                </p>

            </div>

            <a asp-controller="Home"
               asp-action="Questions"
               class="review-button">
                <span>View Questions</span>
                <b>→</b>
            </a>

        </div>


        <div class="bottom-message">

            <span>DESIGNED FOR</span>

            <strong>
                IT ELECTIVE 2
            </strong>

            <span class="separator">•</span>

            <span>
                BSIT 31E3
            </span>

        </div>

    </section>

</div>


<style>

    * {
        box-sizing: border-box;
    }


    body {
        background: #f5f7ff;
    }


    .exam-home {
        position: relative;
        min-height: 100vh;
        margin: -24px;
        overflow: hidden;
        background: #f6f7ff;
        color: #172033;
    }


    .background-shape {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(2px);
    }


    .shape-one {
        width: 380px;
        height: 380px;
        top: 500px;
        left: -180px;
        background: #e2e5ff;
        opacity: .7;
    }


    .shape-two {
        width: 300px;
        height: 300px;
        top: 1050px;
        right: -150px;
        background: #ebe0ff;
        opacity: .6;
    }


    .shape-three {
        width: 180px;
        height: 180px;
        top: 800px;
        right: 10%;
        background: #dfe8ff;
        opacity: .5;
    }


    .hero-section {
        position: relative;
        min-height: 680px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 80px;
        padding: 90px 8%;
        overflow: hidden;
        background: radial-gradient(circle at 10% 20%, rgba(104,117,232,.5), transparent 28%), radial-gradient(circle at 90% 80%, rgba(155,93,229,.45), transparent 30%), linear-gradient(135deg, #10172b, #1b2850 55%, #312c67);
        color: white;
    }


    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 650px;
    }


    .top-label {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 16px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 30px;
        background: rgba(255,255,255,.08);
        backdrop-filter: blur(10px);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
    }


    .label-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #9da8ff;
        box-shadow: 0 0 12px #9da8ff;
    }


    .hero-icon {
        width: 58px;
        height: 58px;
        margin-top: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: linear-gradient(135deg, #6675e8, #9b5de5);
        font-size: 22px;
        font-weight: 800;
        box-shadow: 0 15px 30px rgba(0,0,0,.2);
    }


    .mini-title {
        margin: 25px 0 10px;
        color: #aebaff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 3px;
    }


    .hero-section h1 {
        margin: 0;
        font-size: clamp(48px, 6vw, 76px);
        line-height: .98;
        letter-spacing: -3px;
        font-weight: 900;
    }


        .hero-section h1 span {
            display: block;
            background: linear-gradient(90deg, #aab4ff, #d5b5ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }


    .hero-description {
        max-width: 580px;
        margin: 25px 0;
        color: #cbd3ef;
        font-size: 17px;
        line-height: 1.7;
    }


    .student-card {
        display: flex;
        align-items: center;
        gap: 15px;
        width: fit-content;
        margin: 25px 0;
        padding: 12px 20px 12px 12px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
        background: rgba(255,255,255,.07);
        backdrop-filter: blur(15px);
    }


    .student-avatar {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: white;
        color: #303b7b;
        font-weight: 900;
    }


    .student-details {
        display: flex;
        flex-direction: column;
    }


        .student-details span {
            color: #98a5d0;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 2px;
        }


        .student-details strong {
            margin-top: 3px;
            font-size: 14px;
        }


        .student-details small {
            margin-top: 3px;
            color: #aeb8d5;
        }


    .hero-buttons {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 25px;
    }


    .start-button,
    .info-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding: 15px 21px;
        border-radius: 13px;
        text-decoration: none;
        font-weight: 800;
        transition: .25s;
    }


    .start-button {
        background: white;
        color: #172033;
        box-shadow: 0 12px 30px rgba(0,0,0,.2);
    }


        .start-button b {
            font-size: 20px;
            transition: .25s;
        }


        .start-button:hover {
            color: #172033;
            transform: translateY(-4px);
            box-shadow: 0 18px 35px rgba(0,0,0,.28);
        }


            .start-button:hover b {
                transform: translateX(5px);
            }


    .info-button {
        border: 1px solid rgba(255,255,255,.2);
        color: white;
        background: rgba(255,255,255,.07);
    }


        .info-button:hover {
            color: white;
            background: rgba(255,255,255,.14);
            transform: translateY(-4px);
        }


    .hero-decoration {
        position: relative;
        width: 470px;
        height: 390px;
        flex-shrink: 0;
    }


    .code-window {
        position: absolute;
        top: 55px;
        left: 25px;
        width: 430px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 20px;
        background: #111827;
        box-shadow: 0 35px 70px rgba(0,0,0,.35);
        transform: rotate(2deg);
    }


    .window-top {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 14px 18px;
        background: #1e293b;
        color: #94a3b8;
        font-size: 12px;
    }


    .window-dots {
        display: flex;
        gap: 6px;
    }


        .window-dots i {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #64748b;
        }


    .code-content {
        padding: 28px;
        color: #dbeafe;
        font-family: Consolas, monospace;
        font-size: 14px;
        line-height: 2;
    }


        .code-content p {
            margin: 0;
        }


    .indent {
        padding-left: 25px;
    }


    .code-purple {
        color: #c4b5fd;
    }


    .code-blue {
        color: #67e8f9;
    }


    .code-string {
        color: #86efac;
    }


    .floating-card {
        position: absolute;
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 115px;
        height: 105px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 20px;
        background: rgba(255,255,255,.12);
        backdrop-filter: blur(15px);
        box-shadow: 0 20px 35px rgba(0,0,0,.2);
    }


        .floating-card span {
            font-size: 31px;
            font-weight: 900;
        }


        .floating-card small {
            color: #b9c2e4;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 2px;
        }


    .card-one {
        top: 0;
        right: 15px;
        transform: rotate(6deg);
    }


    .card-two {
        bottom: 5px;
        left: 0;
        transform: rotate(-7deg);
    }


    .content-section {
        position: relative;
        z-index: 2;
        max-width: 1120px;
        margin: auto;
        padding: 100px 25px;
    }


    .section-heading {
        max-width: 700px;
        margin: auto;
        text-align: center;
    }


    .section-tag {
        display: inline-block;
        margin-bottom: 10px;
        color: #6675e8;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 3px;
    }


    .section-heading h2 {
        margin: 0;
        font-size: 42px;
        letter-spacing: -1px;
    }


        .section-heading h2 span {
            color: #6675e8;
        }


    .section-heading p {
        margin-top: 15px;
        color: #687386;
        line-height: 1.7;
    }


    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 55px 0 100px;
    }


    .stat-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 27px;
        border: 1px solid #e8ebf5;
        border-radius: 22px;
        background: rgba(255,255,255,.85);
        box-shadow: 0 15px 35px rgba(30,40,80,.07);
        transition: .25s;
    }


        .stat-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 22px 40px rgba(30,40,80,.11);
        }


    .stat-icon {
        width: 55px;
        height: 55px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #eef0ff;
        color: #6675e8;
        font-size: 20px;
        font-weight: 900;
    }


    .stat-number {
        color: #6675e8;
        font-size: 29px;
        font-weight: 900;
        line-height: 1;
    }


    .stat-title {
        margin-top: 5px;
        font-size: 16px;
        font-weight: 800;
    }


    .stat-text {
        margin-top: 3px;
        color: #7b8494;
        font-size: 12px;
    }


    .topics-section {
        margin-bottom: 90px;
    }


    .topic-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 30px;
    }


        .topic-heading > div:first-child > span {
            color: #6675e8;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 2px;
        }


        .topic-heading h2 {
            margin: 5px 0 0;
            font-size: 34px;
        }


    .topic-count {
        padding: 9px 14px;
        border: 1px solid #e1e5f0;
        border-radius: 30px;
        background: white;
        color: #6675e8;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 2px;
    }


    .topic-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }


    .topic-card {
        position: relative;
        overflow: hidden;
        padding: 30px;
        border: 1px solid #e5e8f1;
        border-radius: 23px;
        background: white;
        transition: .25s;
    }


        .topic-card:hover {
            transform: translateY(-6px);
            border-color: #cbd0f4;
            box-shadow: 0 20px 40px rgba(30,40,80,.09);
        }


    .topic-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }


    .topic-number {
        color: #6675e8;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: 2px;
    }


    .topic-symbol {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #f0f1ff;
        color: #6675e8;
        font-size: 13px;
        font-weight: 900;
    }


    .topic-card h3 {
        margin: 20px 0 8px;
        font-size: 24px;
    }


    .topic-card p {
        margin: 0;
        color: #687386;
        line-height: 1.7;
    }


    .topic-line {
        width: 45px;
        height: 4px;
        margin-top: 25px;
        border-radius: 10px;
        background: #6675e8;
    }


    .review-card {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        overflow: hidden;
        padding: 40px;
        border-radius: 28px;
        background: radial-gradient(circle at 90% 20%, rgba(102,117,232,.5), transparent 25%), #121a31;
        color: white;
        box-shadow: 0 25px 50px rgba(20,30,60,.16);
    }


    .review-decoration {
        position: absolute;
        right: 25%;
        top: -25px;
        display: flex;
        gap: 5px;
        color: rgba(255,255,255,.04);
        font-size: 130px;
        font-weight: 900;
    }


    .review-content {
        position: relative;
        z-index: 2;
    }


    .review-label {
        color: #aeb8ff;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 3px;
    }


    .review-card h2 {
        margin: 8px 0;
        font-size: 32px;
    }


    .review-card p {
        margin: 0;
        color: #b8c1d8;
    }


    .review-button {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 18px;
        padding: 16px 22px;
        border-radius: 13px;
        background: white;
        color: #172033;
        text-decoration: none;
        font-weight: 800;
        white-space: nowrap;
        transition: .25s;
    }


        .review-button b {
            font-size: 19px;
            transition: .25s;
        }


        .review-button:hover {
            color: #172033;
            transform: translateY(-4px);
        }


            .review-button:hover b {
                transform: translateX(5px);
            }


    .bottom-message {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 55px;
        color: #8a93a5;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
    }


        .bottom-message strong {
            color: #6675e8;
        }


    .separator {
        color: #c3c8d5;
    }


    @@media (max-width: 950px) {

        .hero-section {
            flex-direction: column;
            gap: 50px;
            padding: 80px 25px;
            text-align: center;
        }

        .hero-content {
            max-width: 700px;
        }

        .hero-icon {
            margin-left: auto;
            margin-right: auto;
        }

        .student-card,
        .hero-buttons {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-decoration {
            transform: scale(.85);
            margin-top: -30px;
        }
    }


    @@media (max-width: 700px) {

        .exam-home {
            margin: -12px;
        }

        .hero-section {
            min-height: auto;
            padding: 65px 20px;
        }

            .hero-section h1 {
                font-size: 48px;
                letter-spacing: -2px;
            }

        .hero-description {
            font-size: 15px;
        }

        .hero-buttons {
            flex-direction: column;
            width: 100%;
        }

        .start-button,
        .info-button {
            width: 100%;
        }

        .hero-decoration {
            width: 330px;
            height: 310px;
            transform: scale(.75);
            margin: -30px auto -50px;
        }

        .code-window {
            left: 0;
            width: 330px;
        }

        .stats-grid,
        .topic-grid {
            grid-template-columns: 1fr;
        }

        .stats-grid {
            margin-bottom: 70px;
        }

        .section-heading h2 {
            font-size: 32px;
        }

        .topic-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
        }

        .review-card {
            flex-direction: column;
            align-items: flex-start;
            padding: 30px;
        }

            .review-card h2 {
                font-size: 27px;
            }

        .review-button {
            width: 100%;
            justify-content: center;
        }

        .bottom-message {
            flex-wrap: wrap;
            text-align: center;
        }
    }

</style>